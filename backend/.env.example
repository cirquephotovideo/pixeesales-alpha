# PixeeSales Backend - variables d'environnement
# Copier en .env (ou les définir dans Coolify Environment Variables)

PORT=4000
DB_PATH=/data/pixeesales.db
REPORT_TO=arnaud@pixeeplay.com

# Gemini API
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Bridge API (Indy.fr utilise Bridge en interne)
BRIDGE_CLIENT_ID=sandbox_id_...
BRIDGE_CLIENT_SECRET=sandbox_secret_...

# Gmail SMTP (mot de passe d'application Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tonemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="PixeeSales-Alpha <tonemail@gmail.com>"

# Autopilote
AUTOPILOT_ENABLED=false
AUTOPILOT_ICP=PME française e-commerce avec catalogue produit complexe et site obsolète
AUTOPILOT_LEADS_PER_CYCLE=3
AUTOPILOT_MIN_SCORE=70
